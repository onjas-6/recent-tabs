{
  "manifest_version": 3,
  "name": "Arc Recent Tabs",
  "version": "0.1.1",
  "description": "Hold Control to browse recent tabs with private, local preview cards. Release to switch.",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "favicon"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Arc Recent Tabs", "default_popup": "popup.html", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png"} },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "options_page": "options.html",
  "commands": {
    "next-recent": {
      "suggested_key": { "default": "Ctrl+Q", "mac": "MacCtrl+Q" },
      "description": "Select the next most recent tab (hold Control)"
    },
    "previous-recent": {
      "suggested_key": { "default": "Ctrl+Shift+Q", "mac": "MacCtrl+Shift+Q" },
      "description": "Select the previous recent tab (hold Control)"
    }
  },
  "web_accessible_resources": [{
    "resources": ["panel.html", "panel.js", "panel.css"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'self' data:"
  }
}
